# Hugging Face write token: https://huggingface.co/settings/tokens
HF_TOKEN=
# Where the model is published, e.g. yourname/my-jev-4b
HF_REPO=

# Key protecting your vLLM endpoint (any random string)
MY_JEV_API_KEY=
# Your endpoint: http://localhost:8000/v1 on the pod, or https://<POD_ID>-8000.proxy.runpod.net/v1
MY_JEV_URL=http://localhost:8000/v1

# TypeSafe key for the Jev comparison: https://typesafe.ai
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
